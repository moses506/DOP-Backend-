# Copy to .env and adjust. The Makefile loads .env automatically.
# For production see SECURITY.md: APP_ENV=production refuses to start with
# insecure settings (http APP_URL, weak JWT_SECRET, wildcard CORS, ...).
APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://dos:dos@localhost:5432/dos_bpas?sslmode=disable
TEST_DATABASE_URL=postgres://dos:dos@localhost:5432/dos_bpas_test?sslmode=disable
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# How long a sign-in lasts at most, including offline use on a tablet (max 24h in production).
ACCESS_TOKEN_TTL=12h
# Sign people out after this long without using the app (the app warns 2 minutes before).
SESSION_IDLE_TIMEOUT=60m
# Whose X-Forwarded-For header to believe for the visitor's address:
#   empty   = nobody (the server faces the internet directly)
#   private = a reverse proxy on this machine or a private network (nginx, Caddy, Docker)
#   or a comma-separated list of proxy addresses, e.g. 10.0.0.5
TRUSTED_PROXIES=
# Roles that must use two-step verification (authenticator app codes) when signing in.
MFA_REQUIRED_ROLES=admin,ceo,sales_manager
# Encrypts secrets stored in the database, such as authenticator-app keys.
# Generate with: openssl rand -base64 48. If empty, JWT_SECRET is used.
DATA_ENCRYPTION_KEY=
CORS_ORIGINS=http://localhost:5173
APP_TIMEZONE=Africa/Lusaka
# Serve the built frontend from the API server (optional):
# WEB_DIR=../frontend/dist

# Public address of the web app, used for links in emails.
APP_URL=http://localhost:5173

# Outgoing email. Locally this points at Mailpit (make db starts it):
# open http://localhost:8025 to see every email the system sends.
# In production use your provider, e.g. Microsoft 365: smtp.office365.com, port 587,
# or Google Workspace: smtp.gmail.com, port 587 (with an app password).
# Leave SMTP_HOST empty to only write emails to the server log.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@doslimited.com
SMTP_FROM_NAME=DOS BPA

# Company details printed on quotations (and later invoices). Use "|" for line breaks.
# Leave a value empty to leave it off the documents.
COMPANY_NAME=Digital Office Solutions Limited
COMPANY_TAGLINE=Business Solutions Beyond Borders
COMPANY_ADDRESS=Lusaka, Zambia
COMPANY_PHONE=
COMPANY_EMAIL=
COMPANY_WEBSITE=www.doslimited.com
COMPANY_TPIN=
# Bank accounts printed on quotations (the one in the quotation's currency first).
COMPANY_BANK_ZMW=
COMPANY_BANK_USD=
# Used only when neither of the above is set.
COMPANY_BANK_DETAILS=

# Quotations: discounts above this percentage need a sales manager's approval,
# and new quotations are valid for this many days.
QUOTE_APPROVAL_DISCOUNT=10
QUOTE_VALID_DAYS=30
